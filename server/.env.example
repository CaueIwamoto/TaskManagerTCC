# Porta onde a API sobe
PORT=4000

# Origem permitida para requisições com cookies (o front-end em dev)
CLIENT_ORIGIN=http://localhost:5173

# Segredo usado para assinar o JWT de sessão — troque por um valor aleatório forte em produção
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# "development" | "production" — controla a flag "secure" do cookie de sessão
NODE_ENV=development
